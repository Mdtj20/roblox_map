				<Item class="Script" referent="RBX6220">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">RemoveAndCount</string>
						<ProtectedString name="Source">local Ball = script.Parent.Parent.Main.Ball

function onTouched(ItemThatHit)
&#9;print(&quot;Remover Touched&quot;)
&#9;&#9;if ItemThatHit.Name == &quot;Roll&quot; then 
&#9;&#9;&#9;print(&quot;Ball Touched&quot;)
&#9;&#9;&#9;Ball.Value = Ball.Value +1
&#9;&#9;end
end


script.Parent.Touched:connect(onTouched)



</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX6221">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">MessageBox</string>
						<ProtectedString name="Source">function onHit(hit)
&#9;local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if (human ~= nil) then


human.Health = 0
local message = Instance.new(&quot;Message&quot;)
message.Text = &quot;Do not walk on the alleys!&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(4)
message:Remove ()
&#9;end
end

script.Parent.Touched:connect(onHit)</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX6222">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">group regen script</string>
						<ProtectedString name="Source">------------------------------------------------------------------------------------------ 
object = script.Parent 
if (object ~= nil) and (object ~= game.Workspace) then 
model = object 

backup = model:clone() -- Make the backup 
waitTime = 120 --Time to wait between regenerations 
wait(math.random(0, waitTime)) 
while true do 
wait(waitTime) -- Regen wait time 
 
model:remove() 

wait(0)

model = backup:clone() 
model.Parent = game.Workspace 
model:makeJoints() 
message.Parent = nil 
end 
end 
------------------------------------------------------------------------------------------</ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
		<Item class="Script" referent="RBX6223">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Tycoon Money LeaderBoard</string>
				<ProtectedString name="Source">function onPlayerEntered(newPlayer)

&#9;local stats = Instance.new(&quot;IntValue&quot;)
&#9;stats.Name = &quot;leaderstats&quot;

&#9;local cash = Instance.new(&quot;IntValue&quot;)
&#9;cash.Name = &quot;Cash&quot;
&#9;cash.Value = 20

&#9;cash.Parent = stats
&#9;stats.Parent = newPlayer

while true do
&#9;&#9;wait(15)
&#9;&#9;cash.Value = cash.Value + 1
&#9;end
end



game.Players.ChildAdded:connect(onPlayerEntered)</ProtectedString>
			</Properties>
		</Item>
