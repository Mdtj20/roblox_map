player = script.Parent.Parent.Parent.Parent.Parent
money = player.leaderstats.Cash -- Change Gold to the money you want to be used to buy the item
price = 10 -- Your price goes here
tool = game.Lighting:findFirstChild(&quot;Blue Ball&quot;)


function buy()
if money.Value &gt;= price then
money.Value = money.Value - price
local a = tool:clone()
a.Parent = player.Backpack
local b = tool:clone()
b.Parent = player.StarterGear

end
end
