							<ProtectedString name="Source">factory = script.Parent.Parent.Parent
local ting = 0

function onTouched(hit)
	if ting == 0 then
	ting = 1
	local mach = factory:findFirstChild(&quot;Autoprod&quot;)
	if mach == nil then
	local owner = factory.Owner.Value
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil then
		local user = game.Players:GetPlayerFromCharacter(hit.Parent) 
		if owner == user.Name then
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)
				if cash.Value &gt; 149 then
					cash.Value  = cash.Value -150
					machine = factory.Stuff.Autoproducer.Value:clone()
					machine.Parent = factory
					machine:MakeJoints()
					script.Parent.Parent:remove()
					connection:disconnect()
				end
			end
		end
	end
	end
	ting = 0
	end
end

