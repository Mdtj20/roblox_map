				<Item class="ObjectValue" referent="RBX3321">
					<Properties>
						<string name="Name">Bbq</string>
						<Ref name="Value">null</Ref>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="ObjectValue" referent="RBX3322">
					<Properties>
						<string name="Name">Stressless</string>
