					<ProtectedString name="Source">wait(1)
factory = script.Parent
check = factory.SuperReqCheck
local message = Instance.new(&quot;Message&quot;)
message.Text = &quot;You can now make Super-Flour!&quot;
local ting = 0

while check.Value &lt; 3 do
	if ting == 0 then
		ting = 1
		if check.Value == 2 then
			button = factory.Stuff.SuperFlourButton.Value:clone()
			message.Parent = game.Players:findFirstChild(factory.Owner.Value)
			button.Parent = factory
			wait(3)
			message.Parent = nil
			check.Value = 3
		end
		wait(3)
		ting = 0
	end
end
