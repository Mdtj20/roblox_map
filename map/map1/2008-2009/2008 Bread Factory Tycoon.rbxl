					<Item class="Script" referent="RBX1058">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">rep = game.Workspace.Repair
factory = script.Parent.Parent.Parent
parent = factory.Stairs3
fix = factory.BrokenStuff.Stairs3
local ting = 0

function onTouched(hit)
	if ting == 0 then
	ting = 1
