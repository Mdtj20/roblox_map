					<Item class="Script" referent="RBX2098">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Mixing</string>
							<ProtectedString name="Source">local ting = 0
factory = script.Parent.Parent.Parent
dough = factory.NewDough
countwater = factory.Counters.Water
countflour =  factory.Counters.Flour
function onTouch(hit)
	if ting == 0 then
		ting = 1
		if hit.Name == &quot;Water&quot; then
			hit:remove()
			countwater.Value = countwater.Value -1
			dough.Value = dough.Value + 1
			if dough.Value &gt; 3 then
				dough.Value = 0
				newDough = factory.Stuff.Dough.Value:clone()
				newDough.Parent = factory.Doughs
				newDough:MakeJoints()
				script.Parent:remove()
				countflour.Value = countflour.Value - 1
				connection:disconnect()
			end
		end
		ting = 0
	end
end

connection = script.Parent.Touched:connect(onTouch)
