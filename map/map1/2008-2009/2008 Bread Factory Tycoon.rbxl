								<string name="Name">Script</string>
								<ProtectedString name="Source">wait(1)
home = script.Parent.Parent.Parent.Parent
local ting = 0

function onTouched(hit)
	if ting == 0 then
	ting = 1
	local owner = home.Owner.Value
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil then
		local user = game.Players:GetPlayerFromCharacter(hit.Parent) 
		if owner == user.Name then
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)
				if cash.Value &gt; 2499 then
					cash.Value  = cash.Value -2500
					upgrade = home.Stuff.TeleRoof.Value:clone()
					upgrade.Parent = home
					upgrade:MakeJoints()
					script.Parent.Parent:remove()
					connection:disconnect()
				end
			end
		end
	end
	ting = 0
	end
end

connection = script.Parent.Touched:connect(onTouched)
</ProtectedString>
