								<ProtectedString name="Source">factory = script.Parent.Parent.Parent.Parent
local ting = 0

function onTouched(hit)
	if ting == 0 then
	ting = 1
	local owner = factory.Owner.Value
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil then
		local user = game.Players:GetPlayerFromCharacter(hit.Parent) 
		if owner == user.Name then
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)
				if cash.Value &gt; 749 then
					c = factory.Oven.Upgrade:getChildren()
					for i=1, #c do
						c[i].Transparency = 0
					end
					cash.Value = cash.Value -750
					factory.SuperReqCheck.Value = factory.SuperReqCheck.Value + 1
					script.Parent.Parent:remove()
				end
			end
		end
	end
	ting = 0
	end
end

script.Parent.Touched:connect(onTouched)
</ProtectedString>
								<bool name="archivable">true</bool>
