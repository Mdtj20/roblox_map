income = game.Workspace.Repair.Money2
home = script.Parent.Parent.Parent.Parent
name = script.Parent.Parent
local ting = 0

function onTouched(hit)
	if ting == 0 then
	ting = 1
	local owner = home.Owner.Value
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil then
		local user = game.Players:GetPlayerFromCharacter(hit.Parent) 
		if owner == user.Name then
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)

				if income.Value == 32 then
				if cash.Value &gt; 9999 then
					cash.Value  = cash.Value -10000
					income.Value = income.Value * 2
					name.Name = &quot;Income Doubled&quot;
					wait(3)
					name.Name = &quot;Skill Maxed&quot;
				end
				end

				if income.Value == 16 then
				if cash.Value &gt; 3199 then
					cash.Value  = cash.Value -3200
					income.Value = income.Value * 2
					name.Name = &quot;Income Doubled&quot;
					wait(3)
					name.Name = &quot;Improve Repairskill 10000,-&quot;
				end
				end

				if income.Value == 8 then
				if cash.Value &gt; 1599 then
					cash.Value  = cash.Value -1600
					income.Value = income.Value * 2
					name.Name = &quot;Income Doubled&quot;
					wait(3)
					name.Name = &quot;Improve Repairskill 3200,-&quot;
				end
				end

				if income.Value == 4 then
				if cash.Value &gt; 799 then
					cash.Value  = cash.Value -800
					income.Value = income.Value * 2
					name.Name = &quot;Income Doubled&quot;
					wait(3)
					name.Name = &quot;Improve Repairskill 1600,-&quot;
				end
				end

				if income.Value == 2 then
				if cash.Value &gt; 399 then
					cash.Value  = cash.Value -400
					income.Value = income.Value * 2
					name.Name = &quot;Income Doubled&quot;
					wait(3)
					name.Name = &quot;Improve Repairskill 800,-&quot;
				end
				end
				
				if income.Value == 1 then
				if cash.Value &gt; 249 then
					cash.Value  = cash.Value -250
					income.Value = income.Value * 2
					name.Name = &quot;Income Doubled&quot;
					wait(3)
					name.Name = &quot;Improve Repairskill 400,-&quot;
				end
				end

			end
		end
	end
	ting = 0
	end
end

