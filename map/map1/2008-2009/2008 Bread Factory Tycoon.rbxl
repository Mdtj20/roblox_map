						<Item class="Script" referent="RBX3342">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">wait(1)
name = script.Parent.Parent
home = script.Parent.Parent.Parent.Parent
size = home.Housesize
local ting = 0

function onTouched(hit)
	if ting == 0 then
	ting = 1
	local owner = home.Owner.Value
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil then
		local user = game.Players:GetPlayerFromCharacter(hit.Parent) 
		if owner == user.Name then
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)

				if size.Value == 3 then
				if cash.Value &gt; 14999 then
					cash.Value  = cash.Value -15000
					home.House4Remove:remove()
					upgrade = home.Stuff.House5Add.Value:clone()
					upgrade.Parent = home
					upgrade:MakeJoints()
					size.Value = 4
					name.Name = &quot;House-size is maxed!&quot;
					wait(3)
					name:remove()
				end
				end

				if size.Value == 2 then
				if cash.Value &gt; 4999 then
					cash.Value  = cash.Value -5000
					home.House3Remove:remove()
					upgrade = home.Stuff.House4Add.Value:clone()
					upgrade.Parent = home
					upgrade:MakeJoints()
					upgrade = home.Stuff.House4Remove.Value:clone()
					upgrade.Parent = home
					upgrade:MakeJoints()
					size.Value = 3
					name.Name = &quot;House is bigger!&quot;
					wait(3)
					name.Name = &quot;Bigger house! 15000,-&quot;
				end
				end

				if size.Value == 1 then
				if cash.Value &gt; 999 then
					cash.Value  = cash.Value -1000
					home.House2Remove:remove()
					upgrade = home.Stuff.House3Add.Value:clone()
					upgrade.Parent = home
					upgrade:MakeJoints()
					upgrade = home.Stuff.House3Remove.Value:clone()
					upgrade.Parent = home
					upgrade:MakeJoints()
					size.Value = 2
					name.Name = &quot;House is bigger!&quot;
					wait(3)
					name.Name = &quot;Bigger house! 5000,-&quot;
				end
				end

				if size.Value == 0 then
				if cash.Value &gt; 499 then
					cash.Value  = cash.Value -500
					home.House1:remove()
					home.Front.a.BrickColor = BrickColor.new(38)
					home.Front.b.BrickColor = BrickColor.new(38)
					home.Front.c.BrickColor = BrickColor.new(38)
					upgrade = home.Stuff.House2Add.Value:clone()
					upgrade.Parent = home
					upgrade:MakeJoints()
					upgrade = home.Stuff.House2Remove.Value:clone()
					upgrade.Parent = home
					upgrade:MakeJoints()
					size.Value = 1
					name.Name = &quot;House is bigger!&quot;
					wait(3)
					name.Name = &quot;Bigger house! 1500,-&quot;
				end
				end


			end
		end
	end
	ting = 0
	end
end

script.Parent.Touched:connect(onTouched)
</ProtectedString>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
