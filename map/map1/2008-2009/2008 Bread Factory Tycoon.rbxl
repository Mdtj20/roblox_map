			</Properties>
			<Item class="IntValue" referent="RBX2091">
				<Properties>
					<string name="Name">FlourAutoCheck</string>
					<int name="Value">0</int>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX2092">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">AutoFlour</string>
					<ProtectedString name="Source">factory = script.Parent
backup = factory.Stuff.Flour
check = script.Parent.FlourAutoCheck
flourTime = factory.FlourAutoTime
count = factory.Counters.Flour

while true do
	if check.Value == 1 then
		local user = game.Players:findFirstChild(factory.Owner.Value)
		if user ~= nil then
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)
				if cash.Value &gt; 4 then
					if count.Value &lt; 5 then
					cash.Value = cash.Value -5
					flour = backup.Value:clone()
					flour.Parent = factory.Flours
					count.Value = count.Value + 1
					end
					wait(flourTime.Value)
				else
					check.Value = 0
				end
			end
		end
	else
		wait(1)
	end
end
</ProtectedString>
