							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">1FlourBuy</string>
							<ProtectedString name="Source">factory = script.Parent.Parent.Parent
local ting = 0
count = script.Parent.Parent.Parent.Counters.Flour

function onTouch(hit)
if ting == 0 and factory.FlourAutoCheck.Value == 0 then
	ting = 1
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil then
		local user = game.Players:GetPlayerFromCharacter(hit.Parent)
		local owner = factory.Owner.Value
		if owner == user.Name then
			local stats = user:findFirstChild(&quot;leaderstats&quot;)
			if stats ~= nil then
				local cash = stats:findFirstChild(&quot;Money&quot;)
				if cash.Value &gt; 3 then
					if count.Value &lt; 5 then
					cash.Value = cash.Value -4
					newflour = factory.Stuff.Flour.Value:clone()
					newflour.Parent = factory.Flours
					count.Value = count.Value + 1
					end
					wait(2)
				end
			end
		end
	end
	ting = 0
end
end

script.Parent.Touched:connect(onTouch)
</ProtectedString>
