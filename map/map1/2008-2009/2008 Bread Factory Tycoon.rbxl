			<Item class="Script" referent="RBX2094">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ObjectsAndOwnerHandling</string>
					<ProtectedString name="Source">owner = script.Parent.Owner
color = game.Workspace.YellowSpawnLocation.TeamColor
factoryBackup = game.Workspace.Factory4
factory = script.Parent
stuff = factory.Stuff
broken = factory.BrokenStuff

if factoryBackup.Value == nil then  --If the factory hasn&apos;t been stored yet (Game just started)

	--Storing stuff for repairing (storing both repair button and repairable item)
	broken.Oven.Value = factory.Oven.Break:clone()
	broken.Chimney.Value = factory.Oven.Chimney.Break:clone()
	broken.Chocomachine.Value = factory.ChocolateMachine.Break:clone()
	broken.Stairs1.Value = factory.Stairs1.Break:clone()
	broken.Stairs2.Value = factory.Stairs2.Break:clone()
	broken.Stairs3.Value = factory.Stairs3.Break:clone()
	broken.RepairOven.Value = factory:findFirstChild(&quot;Repairman --Fix Oven--&quot;):clone()
	broken.RepairChimney.Value = factory:findFirstChild(&quot;Repairman --Fix Chimney--&quot;):clone()
	broken.RepairChocomachine.Value = factory:findFirstChild(&quot;Repairman --Fix Chocomachine--&quot;):clone()
	broken.RepairStairs1.Value = factory:findFirstChild(&quot;Repairman --Fix Stairs(1)--&quot;):clone()
	broken.RepairStairs2.Value = factory:findFirstChild(&quot;Repairman --Fix Stairs(2)--&quot;):clone()
	broken.RepairStairs3.Value = factory:findFirstChild(&quot;Repairman --Fix Stairs(3)--&quot;):clone()

	--Removing repairbuttons (spawned when stuff breaks)
	factory:findFirstChild(&quot;Repairman --Fix Chimney--&quot;):remove()
	factory:findFirstChild(&quot;Repairman --Fix Oven--&quot;):remove()
	factory:findFirstChild(&quot;Repairman --Fix Chocomachine--&quot;):remove()
	factory:findFirstChild(&quot;Repairman --Fix Stairs(1)--&quot;):remove()
	factory:findFirstChild(&quot;Repairman --Fix Stairs(2)--&quot;):remove()
	factory:findFirstChild(&quot;Repairman --Fix Stairs(3)--&quot;):remove()

	--Storing stuff for later regen
	stuff.Autoproducer.Value = factory.Autoprod:clone()
	stuff.Blocker.Value = factory.Sabotage.Blocker:clone()
	stuff.Chimney.Value = factory.Oven.Chimney:clone()
		factory.Oven.Chimney:remove()--upgradeable part of upgrade
	stuff.Oven.Value = factory.Oven:clone()
	stuff.ChocoMachine.Value = factory.ChocolateMachine:clone()
	stuff.Conveyer.Value = factory.Sabotage.Conveyer:clone()
	stuff.Dough.Value = factory.Doughs.Dough:clone()
	stuff.Fancy.Value = factory.Fancydesk:clone()
	stuff.Flour.Value = factory.Flours.Flour1:clone()
	stuff.Fountain.Value = factory.Fountain:clone()
	stuff.Stairs1.Value = factory.Stairs1:clone()
	stuff.Stairs2.Value = factory.Stairs2:clone()
	stuff.Statue.Value = factory.SuperBreadStatue:clone()
	stuff.SuperDough.Value = factory.Doughs.SuperDough:clone()
	stuff.SuperFlour.Value = factory.Flours.SuperFlour:clone()
	stuff.Superdisp.Value = factory.SuperDispenser:clone()
	stuff.SuperFlourButton.Value = factory:findFirstChild(&quot;Buy 1 super-Flour. 5000,-&quot;):clone()
	stuff.Truck.Value = factory.Truck:clone()
	stuff.Water.Value = factory.Waters.Water:clone()
	stuff.Shaft.Value = factory.Shaft:clone()
	stuff.Mixer.Value = factory.Mixer:clone()
	stuff.ChocoPurifier.Value = factory.Purifier:clone()
	stuff.Nuts.Value = factory.Nuts:clone()

	--Removing stored stuff that can be upgraded/spawned
	factory.Autoprod:remove()
	factory.Sabotage.Blocker:remove()
	factory.Oven:remove()
	factory.ChocolateMachine:remove()
	factory.Doughs.Dough:remove()
	factory.Fancydesk:remove()
	factory.Flours.Flour1:remove()
	factory.Fountain:remove()
	factory.Stairs1:remove()
	factory.Stairs2:remove()
	factory.SuperBreadStatue:remove()
	factory.Doughs.SuperDough:remove()
	factory.Flours.SuperFlour:remove()
	factory.SuperDispenser:remove()
	factory:findFirstChild(&quot;Buy 1 super-Flour. 5000,-&quot;):remove()
	factory.Waters.Water:remove()
	factory.Shaft:remove()
	factory.Purifier:remove()
	factory.Nuts:remove()

	--Storing the basic un-upgraded factory. All upgrades are removed above.
	factoryBackup.Value = script.Parent:clone()
end

wait(1)
while script.Parent ~= nil do
	if owner.Value ~= &quot;&quot; then
		local navn = owner.Value
		leaver = game.Players:FindFirstChild(navn)
		if leaver == nil then
			owner.Value = &quot;&quot;
			MajorReset = factoryBackup.Value:clone()
			script.Parent:remove()
			MajorReset.Parent = game.Workspace
			MajorReset:MakeJoints()
		end
	else
		c = game.Players:getChildren()
		for i=1, #c do
			if c[i].TeamColor == color then
			owner.Value = c[i].Name
			factory.Breakstuff.Value = 1
			end
		end
	end
	wait(1)
end
</ProtectedString>
