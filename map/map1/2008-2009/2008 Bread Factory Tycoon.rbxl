			<Item class="Script" referent="RBX2807">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ObjectAndOwnerHandling</string>
					<ProtectedString name="Source">house = game.Workspace.Homes.Home2			--Different for each home!!
income = game.Workspace.Repair.Money2			--Different for each home!!
stuff = script.Parent.Stuff
owner = game.Workspace.Repair.Owner2			--Different for each home!!
color =  game.Workspace.BlackSpawnLocation.TeamColor

if house.Value == nil then --If the house hasn&apos;t been stored yet (Game just started)
	--Storing stuff for later regen
	stuff.House1.Value = script.Parent.House1:clone()
	stuff.Shack.Value = script.Parent.Shack:clone()
	stuff.House2Add.Value = script.Parent.House2Add:clone()
	stuff.House2Remove.Value = script.Parent.House2Remove:clone()
	stuff.House3Add.Value = script.Parent.House3Add:clone()
	stuff.House3Remove.Value = script.Parent.House3Remove:clone()
	stuff.House4Add.Value = script.Parent.House4Add:clone()
	stuff.House4Remove.Value = script.Parent.House4Remove:clone()
	stuff.House5Add.Value = script.Parent.House5Add:clone()
	stuff.Pool.Value = script.Parent.PoolStuff:clone()
	stuff.Trees.Value = script.Parent.Trees:clone()
	stuff.Road.Value = script.Parent.Road:clone()
	stuff.TeleFact.Value = script.Parent.TeleFact:clone()
	stuff.TeleRoof.Value = script.Parent.TeleRoof:clone()
	stuff.TV.Value = script.Parent.TV:clone()
	stuff.DinnerTable.Value = script.Parent.DinnerTable:clone()
	stuff.Kitchen.Value = script.Parent.Kitchen:clone()
	stuff.Bedroom.Value = script.Parent.Bedroom:clone()
	stuff.Office.Value = script.Parent.Office:clone()
	stuff.Trees2.Value = script.Parent.Trees2:clone()
	stuff.Stressless.Value = script.Parent.Stresslesses:clone()
	stuff.Bbq.Value = script.Parent.Bbq:clone()

	--removing stored stuff that can be upgraded/spawned
	script.Parent.Shack:remove()
	script.Parent.House2Add:remove()
	script.Parent.House2Remove:remove()
	script.Parent.House3Add:remove()
	script.Parent.House3Remove:remove()
	script.Parent.House4Add:remove()
	script.Parent.House4Remove:remove()
	script.Parent.House5Add:remove()
	script.Parent.PoolStuff:remove()
	script.Parent.Trees:remove()
	script.Parent.Road:remove()
	script.Parent.TeleFact:remove()
	script.Parent.TeleRoof:remove()
	script.Parent.TV:remove()
	script.Parent.DinnerTable:remove()
	script.Parent.Kitchen:remove()
	script.Parent.Bedroom:remove()
	script.Parent.Office:remove()
	script.Parent.Trees2:remove()
	script.Parent.Stresslesses:remove()
	script.Parent.Bbq:remove()

	--storing the basic un-upgraded house
	house.Value = script.Parent:clone()
end

--This updates the owner once every second.
wait(1)
while script.Parent ~= nil do
	if owner.Value ~= &quot;&quot; then --if there is an owner, check if he has left
		local navn = owner.Value
		leaver = game.Players:FindFirstChild(navn)
		if leaver == nil then--If the owner is not amongst the players
			owner.Value = &quot;&quot; --reset owner
			income.Value = 1
			MajorReset = house.Value:clone()
			script.Parent:remove() --remove building with upgrades
			MajorReset.Parent = game.Workspace --put in new unupgraded building
			MajorReset:MakeJoints()
		end
	else -- if there is no owner
		c = game.Players:getChildren() --get list of player to check
		for i=1, #c do
			if c[i].TeamColor == color then --If they are on this buildings color, make them owner.
			owner.Value = c[i].Name
			end
		end
	end
	wait(1)
end
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
