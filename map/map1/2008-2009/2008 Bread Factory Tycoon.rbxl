					<Item class="Script" referent="RBX341">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">factory = script.Parent.Parent.Parent
local ting = 0

function onTouched(hit)
	if ting == 0 then
	ting = 1
	print(&quot;touched&quot;)
	local owner = factory.Owner.Value
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if check ~= nil then
		local user = game.Players:GetPlayerFromCharacter(hit.Parent) 
		if owner == user.Name then
			print(&quot;owner ok&quot;)
			newMixer = factory.Stuff.Mixer.Value:clone()
			factory.Mixer:remove()
			newMixer.Parent = factory
			newMixer:MakeJoints()
			script.Parent.Parent.Name = &quot;--Mixer is reset--&quot;
			wait(15)
			script.Parent.Parent.Name = &quot;--Reset Mixer--&quot;
		end
	end
	ting = 0
	end
end

script.Parent.Touched:connect(onTouched)
</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
