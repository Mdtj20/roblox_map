				<Item class="Script" referent="RBX1588">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Weldy</string>
						<ProtectedString name="Source">--[[wait(0.1)
local rap = script.Parent.RAP:GetChildren()
local lap = script.Parent.LAP:GetChildren()
local rlp = script.Parent.RLP:GetChildren()
local llp = script.Parent.LLP:GetChildren()
local hp = script.Parent.HP:GetChildren()
local tp = script.Parent.TP:GetChildren()

function weld(table, weldTo)
	for i = 1, #table do 
		if table[i]:IsA(&quot;BasePart&quot;) then
			local w = Instance.new(&quot;Weld&quot;)
			w.Parent = weldTo
			w.Part0 = w.Parent
			w.C0 = weldTo.CFrame:inverse()
			w.Part1 = table[i]
			w.C1 = table[i].CFrame:inverse()
			--w.Part1.Anchored = false
		end	
	end
	--weldTo.Anchored = false
	for i = 1, #table do
		if table[i]:IsA(&quot;BasePart&quot;) then
			table[i].Anchored = false
		end
	end
	weldTo.Anchored = false
end 

weld(rap, script.Parent[&quot;Right Arm&quot;])
weld(lap, script.Parent[&quot;Left Arm&quot;])
weld(rlp, script.Parent[&quot;Right Leg&quot;])
weld(llp, script.Parent[&quot;Left Leg&quot;])
weld(tp, script.Parent[&quot;Torso&quot;])
weld(hp, script.Parent[&quot;Head&quot;])</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
			<Item class="Script" referent="RBX1589">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ChaseScript</string>
					<ProtectedString name="Source">local larm = script.Parent:FindFirstChild(&quot;Left Arm&quot;)
local rarm = script.Parent:FindFirstChild(&quot;Right Arm&quot;)
local a = 0

function findNearestTorso(pos)
	local list = game.Workspace:children()
	local torso = nil
	local dist = script.Range.Value
	local temp = nil
	local human = nil
	local temp2 = nil
	for x = 1, #list do
		temp2 = list[x]
		if (temp2.className == &quot;Model&quot;) and (temp2 ~= script.Parent) then
			temp = temp2:findFirstChild(&quot;Torso&quot;)
			human = temp2:findFirstChild(&quot;Humanoid&quot;)
			if (temp ~= nil) and (human ~= nil) and (human.Health &gt; 0) then
				if (temp.Position - pos).magnitude &lt; dist then
					torso = temp
					dist = (temp.Position - pos).magnitude
					a = a + 1
					print(a)
					if dist &lt;= 3 and a == 10 then
						a = 0
						script.Parent.Torso[&quot;Right Shoulder&quot;].MaxVelocity = 100000
						script.Parent.Torso[&quot;Left Shoulder&quot;].MaxVelocity = 100000
						script.Parent.Torso[&quot;Right Shoulder&quot;].DesiredAngle = math.pi / 4 * 3
						script.Parent.Torso[&quot;Left Shoulder&quot;].DesiredAngle = math.pi / 4 * -3
						script.Parent.Torso[&quot;Right Shoulder&quot;].CurrentAngle = math.pi / 4 * 3
						script.Parent.Torso[&quot;Left Shoulder&quot;].CurrentAngle = math.pi / 4 * -3
						wait()
						script.Parent.Torso[&quot;Right Shoulder&quot;].MaxVelocity = 0.15
						script.Parent.Torso[&quot;Left Shoulder&quot;].MaxVelocity = 0.15
					end
					if a == 10 then
						a = 0
					end
				end
			end
		end
	end
	return torso
end

function Hit(hit)
	local human = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if human ~= nil then
		human.Health =  human.Health - script.Damage.Value
	end
end

larm.Touched:connect(Hit)
rarm.Touched:connect(Hit)

while true do
