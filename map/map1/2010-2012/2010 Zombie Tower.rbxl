					<string name="Name">KillScript</string>
					<ProtectedString name="Source">function onTouch(part)
	if part.Parent then
		local Zombie = part.Parent:findFirstChild(&quot;Zombie&quot;)
		if (Zombie ~=nil) then
			Zombie.Health = 0
		end
	end
end

script.Parent.Touched:connect(onTouch)</ProtectedString>
