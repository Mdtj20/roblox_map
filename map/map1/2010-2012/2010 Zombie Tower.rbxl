			<Item class="Script" referent="RBX4603">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">MessageInterest</string>
					<ProtectedString name="Source">local GuiMessage = &quot;The Zombies Here Will NOT Give You Any Money&quot;
local Caption = &quot;NOTE:&quot;

local t = Instance.new(&quot;ScreenGui&quot;)
local f = Instance.new(&quot;Frame&quot;, t)--main
local f2 = Instance.new(&quot;Frame&quot;, f)--top
local te = Instance.new(&quot;TextLabel&quot;, f2)--top-caption
local t2 = Instance.new(&quot;TextLabel&quot;, f)--main-caption
local button = Instance.new(&quot;TextButton&quot;, f)--confirm
t.Name = &quot;GUI&quot;
	f.Name = &quot;Window&quot;
		f2.Name = &quot;Top&quot;
			te.Name = &quot;Caption&quot;
		t2.Name = &quot;MainCaption&quot;
		button.Name = &quot;Confirm&quot;
f.Style = &quot;RobloxRound&quot;
f2.Style = &quot;RobloxRound&quot;
button.Style = &quot;RobloxButton&quot;
t2.TextColor3 = Color3.new(1, 1, 1)
te.TextColor3 = Color3.new(1, 1, 1)
button.TextColor3 = Color3.new(1, 1, 1)
te.Font = &quot;ArialBold&quot;
t2.Font = &quot;Arial&quot;
button.Font = &quot;ArialBold&quot;
te.FontSize = &quot;Size14&quot;
t2.FontSize = &quot;Size14&quot;
button.FontSize = &quot;Size18&quot;
button.Text = &quot;OK&quot;
f.Size = UDim2.new(0, 350, 0, 150)
f2.Size = UDim2.new(1, 0, 0, 20)
button.Size = UDim2.new(0, 100, 0, 20)
button.Position = UDim2.new(0.5, -50, 0.75, -10)
t2.Position = UDim2.new(0.5, 0, 0.25, 0)
f2.Position = UDim2.new(0, 0, 0, -27)
te.Position = UDim2.new(0.5, 0, 0.5, 0)
t2.Text = GuiMessage
te.Text = Caption

f.Position = UDim2.new(0.5, -175, 1, 200)
local deb = false
script.Parent.Touched:connect(function(hit)
	if deb == true then return end
	if hit == nil then return end
	deb = true
	local pl = game.Players:FindFirstChild(hit.Parent.Name)
	if pl ~= nil then
		if pl:FindFirstChild(&quot;PlayerGui&quot;) == nil then deb = false return end
		if pl.PlayerGui:FindFirstChild(&quot;GUI&quot;) then deb = false return end
		local s = t:Clone()
		s.Parent = pl.PlayerGui
		s.Window:TweenPosition(UDim2.new(0.5, -175, 0.5, -75), Out, Quad, 1, true)
		s.Window.Confirm.MouseButton1Down:connect(function()
			s.Window:TweenPosition(UDim2.new(0.5, -175, 1, 200), Out, Quad, 1, true)
			wait(1)
			s.Parent = nil
		end)
		wait(3)
	end
	deb = false
end)</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
