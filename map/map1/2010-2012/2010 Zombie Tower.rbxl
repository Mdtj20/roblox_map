	if h then
		if h.Parent:findFirstChild(&quot;Humanoid&quot;) and h.Parent:findFirstChild(&quot;Torso&quot;) and not h.Parent:findFirstChild(n) then
			connectionoogla = h.Parent.Torso.Touched:connect(pooo)
			local baaahhhh = Instance.new(&quot;IntValue&quot;)
			baaahhhh.Parent = h.Parent
			baaahhhh.Name = n
		end
	end
end 

function pooo(h)
	if h.Name == n then
		h.Transparency = 1
		h.CanCollide = false
		connectionoogla:disconnect()
	end
end 

