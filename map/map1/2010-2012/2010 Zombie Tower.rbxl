		<Item class="Script" referent="RBX5159">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">ErrorCheckingScript</string>
				<ProtectedString name="Source">function waitForChild(parent, child)
	while not parent:FindFirstChild(child) do
		parent.ChildAdded:wait()
	end
end

local adminTable = {}

local messageTable = {}
local stackTable = {}
local scriptTable = {}

local playerList = {}

local respawningConnections = {}

waitForChild(script, &quot;AdminGui&quot;)
waitForChild(script, &quot;AdminList&quot;)

local adminGui = script.AdminGui
local adminList = script.AdminList.Value

-- global variables (old admin gui stored data)
	-- UptimeFrame Children
	local upTimeFormattedText = &quot;0 Days, 0 Hours, 0 Minutes, 0 Seconds&quot;
	local upTimeSecondsText = &quot;0 Total Seconds&quot;

	-- PlayerStatsFrame Children
	local avgPlayTimeText = &quot;Avg. Play Time: 0&quot;
	local joinText = &quot;# of Joins: 0&quot;
	local leaveText = &quot;# of Leaves: 0&quot; 
	local uniqueVisitorText = &quot;#of Unique Visits: 0&quot;

	local uniqueUserIds = {}
	local numUniqueUserIds = 0
	local playTimes = {}

	local avgPlayTime = 0
	local placeVisits = 0
	local placeLeaves = 0

function loadAdminTable()
	for a in string.gmatch(adminList, &quot;[^,]+&quot;) do
		adminTable[a:lower()] = true
	end
end

loadAdminTable()

function isAdmin(playa)
	if playa == nil or playa.Name == nil then return end
	if (adminTable[playa.Name:lower()]) then return true end
	return false
end

function makeNewErrorButton(playa, newButton, stackTraceText, badScript)
	newButton.Parent = playa.PlayerGui.AdminGui.AdminStatsFrame.ErrorPanel.ScrollingArea.ScrollingFrame

	local infoBox = playa.PlayerGui.AdminGui.AdminStatsFrame.InfoBox
	local badScriptHook = playa.PlayerGui.AdminGui.ErrorScript
	local toggleBox = playa.PlayerGui.AdminGui.AdminStatsFrame.ToggleBox

	newButton.MouseButton1Click:connect(function() infoBox.Text = stackTraceText badScriptHook.Value = badScript toggleBox.TextColor3 = Color3.new(1, 1, 1) if badScript.Disabled then toggleBox.Text = &quot;Enable Script&quot; else toggleBox.Text = &quot;Disable Script&quot; end end)
end

function updateErrorText(playa)
	playa.PlayerGui.AdminGui.AdminStatsFrame.ScriptStatsFrame.ScriptErrorsFrame.ScriptErrorsTextInfo.Text = &quot;# of Lua Errors: &quot; .. tostring(#messageTable)
end

function updateGuis(message, stackTrace, faultyScript)
	local newError = nil
	for i = 1, #playerList do
		if playerList[i]:FindFirstChild(&quot;PlayerGui&quot;) and playerList[i].PlayerGui:FindFirstChild(&quot;AdminGui&quot;) then
			if newError == nil then
				newError = Instance.new(&quot;TextButton&quot;)
				newError.Name = &quot;NewError&quot;
				newError.Font = Enum.Font.Arial
				newError.FontSize = Enum.FontSize.Size12
				newError.Size = UDim2.new(1,0,0,12)
				newError.BackgroundTransparency = 0.5
				newError.TextColor3 = Color3.new(1,1,1)
				newError.Text = message
				newError.TextWrap = true
				newError.TextXAlignment = Enum.TextXAlignment.Left
				newError.TextYAlignment = Enum.TextYAlignment.Top
				newError.Visible = true
			end
			local newErrorClone = newError:Clone()
			
			local success = pcall(makeNewErrorButton, playerList[i], newErrorClone, stackTrace, faultyScript)
			local success2 = pcall(updateErrorText, playerList[i])
			if not success or not success2 then
				-- do nothing for now...
				-- remove offending player from list of admins
				--table.remove(playerList, i)
			end
		end
	end
end

function storeError(message, stack, otherScript)
	-- only store the first 100 errors
	if #messageTable &lt; 100 then  -- note: if THIS script errors out inside of updateGuis fcn, that could cause place to crash...  can check if otherScript ~= script here if we wish to avoid this
		table.insert(messageTable, message)
		table.insert(stackTable, stack)
		table.insert(scriptTable, otherScript)

		updateGuis(message, stack, otherScript)
	end
end

