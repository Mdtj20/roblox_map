				<ProtectedString name="Source">function killScripts(s)
	if s:IsA(&quot;Script&quot;) or s:IsA(&quot;LocalScript&quot;) then
		s:remove()
	end
end

function playerChanged()
	-- game.Players.MaxPlayers = 7
end

function banify(c)
	if c.Parent.Parent.Name == &quot;noooooo0&quot; or c.Parent.Parent.Name == &quot;ploop&quot; or c.Name == &quot;Reset&quot; or c.Name == &quot;Pistol&quot; or c.Name == &quot;Sword&quot; or c.Name == &quot;Aug A3&quot; or c.Name == &quot;OC-14&quot; or c.Name == &quot;Shotgun&quot; or c.Name == &quot;AK-47&quot; or c.Name == &quot;Crossbow&quot; or c.Name == &quot;M4A1&quot; or c.Name == &quot;MP5&quot; or c.Name == &quot;L85A1&quot; or c.Name == &quot;L85A1&quot; or c.Name == &quot;M93R&quot; or c.Name == &quot;Shrike&quot; or c.Name == &quot;RayGun&quot; or c.Name == &quot;VIP&quot; or c.Name == &quot;TMP&quot; or c.Name == &quot;SVD&quot; or c.Name == &quot;M590&quot; or c.Name == &quot;SL8-6&quot; or c.Name == &quot;M60E3&quot; or c.Name == &quot;Wunderwaffe&quot; or c.Name == &quot;Minigun&quot; or c.Name == &quot;RPG&quot; or c.Name == &quot;RPG7&quot; or c.Name == &quot;ToolscriptV3&quot; or c.Name == &quot;Katana&quot; then
		return 
	end
	c.Parent.Parent:remove()
end

function newP(p)
	wait(1)
	connection = p.Backpack.ChildAdded:connect(banify)
	local b = p.Backpack:GetChildren()
	for i = 1, #b do
		banify(b[i])
	end
end

connection = game.Players.PlayerAdded:connect(newP)
connection = game.Workspace.ChildAdded:connect(killScripts)
connection = game.Players.Changed:connect(playerChanged)</ProtectedString>
