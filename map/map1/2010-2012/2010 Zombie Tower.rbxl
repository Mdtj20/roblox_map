			<Item class="Script" referent="RBX3699">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Muneh</string>
					<ProtectedString name="Source">local amount = script.MoneyAmount.Value
local currency = script.Currency.Value

function die()
	if script.Parent.Zombie:findFirstChild(&quot;creator&quot;) then
		script.Parent.Zombie:findFirstChild(&quot;creator&quot;).Value.leaderstats:findFirstChild(currency).Value = script.Parent.Zombie:findFirstChild(&quot;creator&quot;).Value.leaderstats:findFirstChild(currency).Value + amount
	end
end 

connection = script.Parent.Zombie.Died:connect(die)</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="NumberValue" referent="RBX3700">
					<Properties>
						<string name="Name">MoneyAmount</string>
						<double name="Value">23</double>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="StringValue" referent="RBX3701">
					<Properties>
						<string name="Name">Currency</string>
						<string name="Value">Money</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
			<Item class="Script" referent="RBX3702">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Weldy2</string>
					<ProtectedString name="Source">local rap = script.Parent.RAP:GetChildren()
local lap = script.Parent.LAP:GetChildren()
local rlp = script.Parent.RLP:GetChildren()
local llp = script.Parent.LLP:GetChildren()
local hp = script.Parent.HP:GetChildren()
local tp = script.Parent.TP:GetChildren()

function WELDY(table, weldTo)
	local w2 = Instance.new(&quot;Weld&quot;)
	w2.Parent = script.Parent.Torso
	w2.Part0 = w2.Parent
	w2.C0 = CFrame.new()
	w2.Part1 = script.Parent.Head
	w2.C1 = CFrame.new(0, -1.5, 0)
	for i = 1, #table do 
		if table[i]:IsA(&quot;BasePart&quot;) then
			local w = Instance.new(&quot;Weld&quot;)
			w.Parent = weldTo
			w.Part0 = w.Parent
			w.C0 = weldTo.CFrame:inverse()
			w.Part1 = table[i]
			w.C1 = table[i].CFrame:inverse()
			w.Part1.Anchored = false
		end	
	end
	weldTo.Anchored = false
	for i = 1, #table do
		if table[i]:IsA(&quot;BasePart&quot;) then
			table[i].Anchored = false
		end
	end
	weldTo.Anchored = false
end 

function CFRAMEIT(table, weldTo)
	for i = 1, #table do
		if table[i]:IsA(&quot;BasePart&quot;) then
			local cf = table[i].CFrame
			local v = Instance.new(&quot;CFrameValue&quot;)
			v.Name = &quot;CF&quot;
			v.Value = cf
			v.Parent = table[i]
		end
	end
	local v = Instance.new(&quot;CFrameValue&quot;)
	v.Name = &quot;CF&quot;
	v.Value = weldTo.CFrame
	v.Parent = weldTo
end

function WELDIT(table, weldTo)
	if not weldTo:findFirstChild(&quot;CF&quot;) then
		WELDY(table, weldTo)
	elseif weldTo:findFirstChild(&quot;CF&quot;) then
		for i = 1, #table do
			if table[i]:IsA(&quot;BasePart&quot;) then
				local w = Instance.new(&quot;Weld&quot;)
				w.Parent = weldTo
				w.Part0 = w.Parent
				w.C0 = weldTo.CF.Value:inverse()
				w.Part1 = table[i]
				w.C1 = table[i].CF.Value:inverse()
				table[i].Anchored = false
			end
		end
		weldTo.Anchored = false
	end
end

function weld(table, weldTo)
	--if script.Parent.Parent ~= game.Workspace then
		--CFRAMEIT(table, weldTo)
	--if script.Parent.Parent == game.Workspace then
		WELDIT(table, weldTo)
	--end
end 

weld(rap, script.Parent[&quot;Right Arm&quot;])
weld(lap, script.Parent[&quot;Left Arm&quot;])
weld(rlp, script.Parent[&quot;Right Leg&quot;])
weld(llp, script.Parent[&quot;Left Leg&quot;])
weld(tp, script.Parent[&quot;Torso&quot;])
weld(hp, script.Parent[&quot;Head&quot;])</ProtectedString>
