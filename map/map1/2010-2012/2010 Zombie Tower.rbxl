			<Item class="Script" referent="RBX4093">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Muneh</string>
					<ProtectedString name="Source">local amount = script.MoneyAmount.Value
local currency = script.Currency.Value

function die()
	if script.Parent.Zombie:findFirstChild(&quot;creator&quot;) then
		script.Parent.Zombie:findFirstChild(&quot;creator&quot;).Value.leaderstats:findFirstChild(currency).Value = script.Parent.Zombie:findFirstChild(&quot;creator&quot;).Value.leaderstats:findFirstChild(currency).Value + amount
	end
end 

connection = script.Parent.Zombie.Died:connect(die)</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
				<Item class="NumberValue" referent="RBX4094">
					<Properties>
						<string name="Name">MoneyAmount</string>
						<double name="Value">23</double>
						<bool name="archivable">true</bool>
					</Properties>
