			<Item class="Script" referent="RBX3296">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">brick = script.Parent:Clone()

function onTouch(part)
	local humanoid = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (humanoid ~=nil) then
		wait(.5)
		script.Parent.Anchored = false
		wait(10)
		brick.Parent = script.Parent.Parent
		brick.Transparency = 1
		brick.Reflectance = 1
		brick.Anchored = true
		for i = 1,10 do
			script.Parent.Transparency = script.Parent.Transparency + 0.1
			script.Parent.Reflectance = script.Parent.Reflectance + 0.1
			wait(0.04)
		end
		for i = 1,7 do
			brick.Transparency = brick.Transparency - 0.1
			brick.Reflectance = brick.Reflectance - 0.1
			wait(0.04)
		end
		script.Parent:Remove()	
		brick.Transparency = 0.3
		brick.Reflectance = 0.3
	end
end

script.Parent.Touched:connect(onTouch)
</ProtectedString>
