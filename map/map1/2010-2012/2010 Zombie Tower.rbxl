			<Item class="Script" referent="RBX4596">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">wait()

local zName = &quot;TZombie2&quot; --Change h4x to the name of the zombie in the lighting

local z = game.Lighting:findFirstChild(zName):clone()
local zom = nil

function regen()
	if zom then 
		zom.Parent = nil
	end
	local z2 = z:clone()
	zom = z2
	zom:MakeJoints()
	zom.Parent = game.Workspace
	zom:MoveTo(script.Parent.Position + Vector3.new(0, 4, 0))
	zom:MakeJoints()
	local zP = zom:GetChildren()
	for i = 1, #zP do 
		if zP[i]:IsA(&quot;Script&quot;) then
			zP[i].Disabled = false
		end
		if zP[i]:IsA(&quot;Humanoid&quot;) then
			zP[i].Died:connect(die)
		end
	end
end

function die()
	wait(5)
	regen()
end 

wait(10)

regen()</ProtectedString>
