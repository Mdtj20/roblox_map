				<ProtectedString name="Source">wait(3)
local going = true
local players = {}
local thingy = game.Workspace.Rparts
local clone = thingy:clone()
local waitTime = 30
print(&apos;Variables initialized.&apos;) 

function remove(player)
for i = 1, #players do
if players[i] == player then
table.remove(players, i)
end 
end
print(&apos;Removed.&apos;)
if #players == 0 then 
local n1 = script.Name
script.Name = math.random(-100, 100)
if script.Name == n1 then
script.Name = &quot;ooooo&quot;
end
end
print(&apos;Done.&apos;) 
end

function genocide()
local p = game.Players:GetChildren()	
for i = 1, #p do 
if p[i].Character then
local h = p[i].Character:findFirstChild(&quot;Humanoid&quot;)
if h then
h.Health = 0
end
end
end
print(&apos;genocide() finished.&apos;) 
end 

function tele(part)
local p = game.Players:GetChildren()	
for i = 1, #p do 
if p[i].Character then
local h = p[i].Character:findFirstChild(&quot;Torso&quot;)
if h then
table.insert(players, 1, p[i])
local pl = Instance.new(&quot;NumberValue&quot;)
pl.Name = &quot;Playing&quot;
pl.Parent = h.Parent
connection = p[i].Character.Humanoid.Died:connect(function () remove(p[i]) end)
h.CFrame = part.CFrame + Vector3.new(math.random(-10, 10), 0, math.random(-10, 10))
print(&apos;CFraming/teleporting successful.&apos;) 
end
end
end
end

function zombiecide()
local z = game.Workspace:GetChildren()
for i = 1, #z do
if z[i]:findFirstChild(&quot;Zombie&quot;) then
if z[i]:findFirstChild(&quot;Zombie&quot;):IsA(&quot;Humanoid&quot;) then
z[i]:findFirstChild(&quot;Zombie&quot;).Health = -1337
print(&apos;Zombified!&apos;) 
end
end
end
local b = game.Workspace:GetChildren()
for i = 1, #b do
	if b[i].Name == &quot;Bullet&quot; then
		b[i]:remove()
	end
end
end

function regen()
if thingy then
thingy.Parent = nil
end
local c = clone:clone()
c.Parent = game.Workspace
thingy = c
end

function round()
genocide()
players = {}
wait(waitTime)
print(&quot;Wait over&quot;)
game.Workspace.lolol.Value = true
tele(game.Workspace.TELEPORTER)
script.Changed:wait()
game.Workspace.lolol.Value = false
regen()
zombiecide()
print(&apos;round()&apos;) 
end 

function winnar(h)
	if h and not going then
		if h.Parent:findFirstChild(&quot;Humanoid&quot;) then
			going = true
			local l = game.Lighting.Ambient
			local m = Instance.new(&quot;Message&quot;)
			m.Parent = game.Workspace
			--for i = 1, 20 do
				m.Text = &quot;WINNAR!&quot;
				--game.Lighting.Ambient = Color3.new(math.random(0,255), math.random(0,255), math.random(0,255))
				wait(4)
				--m.Text = &quot;&quot;
				--game.Lighting.Ambient = Color3.new(math.random(0,255), math.random(0,255), math.random(0,255))
				--wait(0.2)
			--end
			m.Parent = nil
			game.Lighting.Ambient = l
			genocide()
			wait(5)
			going = false
		end
	end
end

connection = game.Workspace.Victory.Touched:connect(winnar)

function pas(p)
	connection = remove(p)
end
connection = game.Players.PlayerRemoving:connect(pas)

while true do 
round()
print(&apos;Round function successfully called inside while loop.&apos;) 
wait() 
end 
