if bf ~= nil then
bf.force = Vector3.new(0,0,0)
else
local bf = Instance.new(&quot;BodyForce&quot;)
bf.Name = &quot;BF&quot;
bf.force = Vector3.new(0,0,0)
bf.Parent = torso
end
