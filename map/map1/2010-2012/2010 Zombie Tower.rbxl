		<Item class="Script" referent="RBX3057">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Zombie</string>
				<ProtectedString name="Source">local z = game.Lighting[script.Name]
local rap = z.RAP:GetChildren()
local lap = z.LAP:GetChildren()
local rlp = z.RLP:GetChildren()
local llp = z.LLP:GetChildren()
local hp = z.HP:GetChildren()
local tp = z.TP:GetChildren()

function WELDY(table, weldTo)
	for i = 1, #table do 
		if table[i]:IsA(&quot;BasePart&quot;) then
			local w = Instance.new(&quot;Weld&quot;)
			w.Parent = weldTo
			w.Part0 = w.Parent
			w.C0 = weldTo.CFrame:inverse()
			w.Part1 = table[i]
			w.C1 = table[i].CFrame:inverse()
			w.Part1.Anchored = false
		end	
	end
	weldTo.Anchored = false
end 

function CFRAMEIT(table, weldTo)
	for i = 1, #table do
		if table[i]:IsA(&quot;BasePart&quot;) then
			local cf = table[i].CFrame
			local v = Instance.new(&quot;CFrameValue&quot;)
			v.Name = &quot;CF&quot;
			v.Value = cf
			v.Parent = table[i]
		end
	end
	local v = Instance.new(&quot;CFrameValue&quot;)
	v.Name = &quot;CF&quot;
	v.Value = weldTo.CFrame
	v.Parent = weldTo
end

function WELDIT(table, weldTo)
	if not weldTo:findFirstChild(&quot;CF&quot;) then
		WELDY(table, weldTo)
	elseif weldTo:findFirstChild(&quot;CF&quot;) then
		for i = 1, #table do
			if table[i]:IsA(&quot;BasePart&quot;) then
				local w = Instance.new(&quot;Weld&quot;)
				w.Parent = weldTo
				w.Part0 = w.Parent
				w.C0 = weldTo.CF.Value:inverse()
				w.Part1 = table[i]
				w.C1 = table[i].CF.Value:inverse()
				table[i].Anchored = false
			end
		end
		weldTo.Anchored = false
	end
end

function weld(table, weldTo)
	if script.Parent.Parent ~= game.Workspace then
		CFRAMEIT(table, weldTo)
	elseif script.Parent.Parent == game.Workspace then
		WELDIT(table, weldTo)
	end
end 

CFRAMEIT(rap, z[&quot;Right Arm&quot;])
CFRAMEIT(lap, z[&quot;Left Arm&quot;])
CFRAMEIT(rlp, z[&quot;Right Leg&quot;])
CFRAMEIT(llp, z[&quot;Left Leg&quot;])
CFRAMEIT(tp, z[&quot;Torso&quot;])
CFRAMEIT(hp, z[&quot;Head&quot;])</ProtectedString>
