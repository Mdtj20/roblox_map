						<string name="Name">Script</string>
						<ProtectedString name="Source">function spawn()
	for i = 1, script.Number.Value do 
		local sx = script.Parent.Spawn.Size.x / 2
		local sz = script.Parent.Spawn.Size.z / 2
		local z = game.Lighting.Zombie999:clone()
		local zombie = z

		local w = Instance.new(&quot;Weld&quot;)
		w.Name = &quot;Neck&quot;
		w.Parent = zombie.Torso
		w.Part0 = zombie.Torso
		w.Part1 = zombie.Head
		w.C0 = CFrame.new()
		w.C1 = CFrame.new(0, -1.5, 0)	
		
		z:MakeJoints()
		z.Parent = game.Workspace
		z:MakeJoints()
		--z:MoveTo(script.Parent.Spawn.Position + Vector3.new(math.random(-sx, sx), 3, math.random(-sz, sz)))
		z:MakeJoints()
		z.Torso.CFrame = script.Parent.Spawn.CFrame + Vector3.new(math.random(-sx, sx), 3, math.random(-sz, sz))
		zombie.ChaseScript.Damage.Value = script.Damage.Value
		zombie.ChaseScript.Range.Value = script.Range.Value
		zombie.Zombie.WalkSpeed = script.Speed.Value
		zombie.Zombie.MaxHealth = script.Health.Value
		zombie.Zombie.Health = zombie.Zombie.MaxHealth
		local s = z:GetChildren()
		for i = 1, #s do
			if s[i]:IsA(&quot;Script&quot;) then
				s[i].Disabled = false
			end
		end
	end
	connection:disconnect()
end

