					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Bullet</string>
					<ProtectedString name="Source">wait()
local bl = Instance.new(&quot;Part&quot;)
local bah = false
bl.Locked = true
bl.BrickColor = BrickColor.new(21)
bl.formFactor = 2
bl.Size = Vector3.new(1,0.4,1)
script.BulletHit.Disabled = false

function onHit(hit)
	if hit.Parent == nil then
		return
	end

	script.Die.Disabled = false

	if hit.Parent:FindFirstChild(&quot;Zombie&quot;) == nil or bah then
		--wait(2.5)
		script.Parent:Remove()
		return
	end
	bah = true
	if not hit.Parent:FindFirstChild(&quot;Zombie&quot;):IsA(&quot;Humanoid&quot;) then
		return
	end
	
	for i = 1, 5 do
		--bleed()
	end

	local damage = math.random(20 * script.Damage.Value, 30 * script.Damage.Value)
	
	if hit.Name == &quot;Head&quot; then
		damage = damage + math.random(100,1700)
		for i = 1, 7 do
			--bleed()
		end
	end
	
	hit.Parent.Zombie:TakeDamage(damage)
	local creator = script.Parent:FindFirstChild(&quot;creator&quot;)
	if creator ~= nil then
		local c = creator:Clone()
		c.Parent = hit.Parent.Zombie
		local s = script.Die:clone()
		s.Disabled = false
		s.Parent = c
	end
	script.Parent:Remove()
end

script.Parent.Touched:connect(onHit)

wait(5)

script.Parent:Remove()
