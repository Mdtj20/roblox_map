							<string name="Source">function onTouch(part)
	if part ~= nil then
		if part.Size.x &lt; 40 and part.Size.y &lt; 40 and part.Size.z &lt; 40 then
			if part.Parent.Name == &quot;Workspace&quot; or part.Parent:findFirstChild(&quot;Humanoid&quot;) then
			if part:findFirstChild(&quot;Disco&quot;) ~= nil then part.Disco:remove() end
			part.BrickColor = script.Parent.BrickColor
			part.Transparency = 0
			end
			end
		end
	end

