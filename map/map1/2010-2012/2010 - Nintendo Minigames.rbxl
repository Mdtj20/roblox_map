				<Item class="Script" referent="RBX39">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">ChangeShirt/Pants</string>
						<string name="Source">--theRal

worker = false
part = script.Parent

function onTouch(hit)
	local human = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if (human ~= nil) and (worker == false) then
		print (&quot;Success&quot;)
		worker = true
		wait(.1)
		local pant = hit.Parent:GetChildren()
		for i=1,#pant do
		if (pant[i].className == &quot;Pants&quot;) then
			pant[i].PantsTemplate = &quot;&quot;
			end
		end
		local shirt = hit.Parent:GetChildren()
		for i=1,#shirt do
		if (shirt[i].className == &quot;Shirt&quot;) then
			shirt[i].ShirtTemplate = &quot;&quot;
			wait(1)
			worker = false
			end
		end
	end
end

