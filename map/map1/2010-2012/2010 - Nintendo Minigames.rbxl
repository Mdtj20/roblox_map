function findBestNode(set, scores)
	local bestScore = nil
	local bestValue = nil

	for key, value in pairs(set) do
		if value then
			if bestValue == nil or scores[key] &lt; bestScore then
				bestScore = scores[key]
				bestValue = key
			end
		end
	end

	return bestValue
end


--[[function makePath(parentList, endNode)
	if parentList[endNode] then
		makePath(parentList, parentList[endNode])
		return p + endNode
