	n = 0
	while n &lt; 5 do
		n = n + .1
		script.Parent.CFrame = script.Parent.CFrame * CFrame.new(0,0,.6)
		wait()
		end
	wait(1)
	n = 0
	while n &lt; 5 do
		n = n + .1
		script.Parent.CFrame = script.Parent.CFrame * CFrame.new(0,0,-.6)
