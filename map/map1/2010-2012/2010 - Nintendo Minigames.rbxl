-- horizontal edges, vertical edges, ring edges, respectively
local twoWayEdges = {{1, 2}, {2, 3}, {3, 4}, {5, &quot;6l&quot;}, {&quot;6r&quot;, &quot;7l&quot;}, {&quot;7r&quot;, 8}, {9, &quot;10l&quot;}, {&quot;10r&quot;, &quot;11l&quot;}, {&quot;11r&quot;, 12}, {13, 14}, {14, 15}, {15, 16},
					{1, 5}, {5, 9}, {9, 13}, {2, &quot;6u&quot;}, {&quot;6d&quot;, &quot;10u&quot;}, {&quot;10d&quot;, 14}, {3, &quot;7u&quot;}, {&quot;7d&quot;, &quot;11u&quot;}, {&quot;11d&quot;, 15}, {4, 8}, {8, 12}, {12, 16},
					{&quot;6l&quot;, &quot;6u&quot;}, {&quot;6u&quot;, &quot;6r&quot;}, {&quot;6r&quot;, &quot;6d&quot;}, {&quot;6d&quot;, &quot;6l&quot;}, {&quot;7l&quot;, &quot;7u&quot;}, {&quot;7u&quot;, &quot;7r&quot;}, {&quot;7r&quot;, &quot;7d&quot;}, {&quot;7d&quot;, &quot;7l&quot;},  
					{&quot;10l&quot;, &quot;10u&quot;}, {&quot;10u&quot;, &quot;10r&quot;}, {&quot;10r&quot;, &quot;10d&quot;}, {&quot;10d&quot;, &quot;10l&quot;}, {&quot;11l&quot;, &quot;11u&quot;}, {&quot;11u&quot;, &quot;11r&quot;}, {&quot;11r&quot;, &quot;11d&quot;}, {&quot;11d&quot;, &quot;11l&quot;}}

local oneWayEdges = {}


-- convert edges into useful datastructure for searching [one-time cost]
local network = {}
local costs = {} -- we&apos;ll keep the structure of this table identical to that of the network

function dist(nodeOne, nodeTwo)
	return math.sqrt((nodeOne.Position - nodeTwo.Position):Dot(nodeOne.Position - nodeTwo.Position))
end

-- adds an edge going from edge[1] to edge[2]
function addOneWayNeighbor(edge)
	-- take care of net structure
	if network[tostring(edge[1])] == nil then network[tostring(edge[1])] = {} costs[tostring(edge[1])] = {} end
	table.insert(network[tostring(edge[1])], tostring(edge[2]))

	-- add in costs of edges
	local wayPoint1 = wayPoints:FindFirstChild(tostring(edge[1]))
	local wayPoint2 = wayPoints:FindFirstChild(tostring(edge[2]))
	if wayPoint2 == nil then print(tostring(edge[2])) end
	
	local edgeCost = dist(wayPoint1, wayPoint2)
	table.insert(costs[tostring(edge[1])], edgeCost)
end

-- adds an edge going from edge[1] to edge[2] and back again
function addNeighbors(edge)
	-- take care of net structure
	if network[tostring(edge[1])] == nil then network[tostring(edge[1])] = {} costs[tostring(edge[1])] = {} end
	if network[tostring(edge[2])] == nil then network[tostring(edge[2])] = {} costs[tostring(edge[2])] = {} end
	table.insert(network[tostring(edge[1])], tostring(edge[2]))
	table.insert(network[tostring(edge[2])], tostring(edge[1]))

	-- add in costs of edges
	local wayPoint1 = wayPoints:FindFirstChild(tostring(edge[1]))
	local wayPoint2 = wayPoints:FindFirstChild(tostring(edge[2]))
	if wayPoint2 == nil then print(tostring(edge[2])) end
	--local edgeCost = math.sqrt((wayPoint1.Position - wayPoint2.Position):Dot(wayPoint1.Position - wayPoint2.Position))
	local edgeCost = dist(wayPoint1, wayPoint2)
	table.insert(costs[tostring(edge[1])], edgeCost)
	table.insert(costs[tostring(edge[2])], edgeCost)
end

for i = 1, #twoWayEdges do
	addNeighbors(twoWayEdges[i])
end

for i = 1, #oneWayEdges do
	addOneWayNeighbor(oneWayEdges[i])
end


-- set functions
function setAdd(set, key)
     set[key] = true 
end  

function setRemove(set, key)
     set[key] = nil
 end  

function setContains(set, key)
     return set[key] 
end 


