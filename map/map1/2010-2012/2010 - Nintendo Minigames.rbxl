						<string name="Source">local Tool = script.Parent;
mode = 1
enabled = true
tip = script.Parent.Tip

function onButton1Down(mouse)
	if not enabled then
		return
	end

	enabled = false
	mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;

	wait(.5)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	enabled = true

end


function onKeyDown(key) 
	if (key~=nil) then 
		local key = key:lower() 
		--[[if (key==&quot;q&quot;) then 
			mode = mode + 1
			if mode &gt; 8 then mode = 1 end

			if mode == 1 then
				tip.BrickColor = BrickColor.Red()
				elseif mode == 2 then
				tip.BrickColor = BrickColor.Blue()
				elseif mode == 3 then
				tip.BrickColor = BrickColor.Yellow()
				elseif mode == 4 then
				tip.BrickColor = BrickColor.Green()
				elseif mode == 5 then
				tip.BrickColor = BrickColor.new(104)
				elseif mode == 6 then
				tip.BrickColor = BrickColor.new(106)
				elseif mode == 7 then
				tip.BrickColor = BrickColor.new(1)
				elseif mode == 8 then
				tip.BrickColor = BrickColor.new(26)
				end

			end]]
		end
	end

function onEquippedLocal(mouse)

	player = script.Parent.Parent.Parent
	if player ~= nil then

		if mouse == nil then
			print(&quot;Mouse not found&quot;)
			return 
		end

		mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
		mouse.Button1Down:connect(function() onButton1Down(mouse) end)
		mouse.KeyDown:connect(onKeyDown) 

		--[[m = Instance.new(&quot;Message&quot;)
		m.Text = &quot;Press Q to switch colors&quot;
		m.Parent = player
		wait(3)
		m:remove()]]
	end
end

function onUnequippedLocal()
	--if m ~= nil then m:remove() end
end


Tool.Equipped:connect(onEquippedLocal)
Tool.Unequipped:connect(onUnequippedLocal)
