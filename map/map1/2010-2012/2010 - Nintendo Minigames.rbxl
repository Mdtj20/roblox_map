					<string name="Source">function onSelected()
	if m then m:remove() end
	player = script.Parent.Parent.Parent
	char = script.Parent.Parent.Parent.Character 
	if char then

		if char:findFirstChild(&quot;Spectating&quot;) == nil then
			local value = Instance.new(&quot;IntValue&quot;)
			value.Parent = char
			value.Name = &quot;Spectating&quot;
			end

			m = Instance.new(&quot;Message&quot;)
			m.Parent = player
			m.Text = &quot;You are now in Spectating mode.&quot;
			m.Name = &quot;Reminder&quot;

			wait(3)
			m:remove()
		end
	end

function onDeselected()
	if m then m:remove() end

	if char:findFirstChild(&quot;Spectating&quot;) ~= nil then char.Spectating:remove() end

	m = Instance.new(&quot;Message&quot;)
	m.Parent = player
	m.Text = &quot;You are now in Playing mode.&quot;
	m.Name = &quot;Reminder&quot;
	wait(3)
	m:remove()
	end

