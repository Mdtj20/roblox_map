function onClick(part)
	if script.Parent.Parent.Debounce.Value == false then
		script.Parent.Parent.Debounce.Value = true
		script.Parent.Head.BrickColor = BrickColor.new(21)
		game.Workspace.ChosenMinigame.Value = script.Parent.Name
		m = Instance.new(&quot;Message&quot;)
		m.Parent = game.Workspace
		m.Text = &quot;The player has chosen &quot; .. script.Parent.Name .. &quot; as the next minigame&quot;
		wait(3)
		m:remove()
		script.Parent.Head.BrickColor = original
		end
	end

