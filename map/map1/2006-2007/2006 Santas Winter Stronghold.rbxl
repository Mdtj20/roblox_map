function plant()
	local bomb = Instance.new(&quot;Part&quot;)

        

	local spawnPos = game.Players.LocalPlayer.Character.PrimaryPart.Position


	

	bomb.Position = Vector3.new(spawnPos.x, spawnPos.y+3, spawnPos.z)
