				<string name="Name">GiftScript</string>
				<string name="Source">function getPlayer(humanoid)
	-- find the owning player of a humanoid. this is a hack and i don&apos;t know why i need it, game.Players.LocalPlayer didn&apos;t work
	local players = game.Players:children()
	for i = 1, #players do
		if players[i].Character.Humanoid == humanoid then return players[i] end
	end
	return nil
end

function getRole(player)
	if player:findFirstChild(&quot;Role&quot;) ~= nil then
		return player.Role.Value
	end
	return nil
end

function addGift(humanoid)


	local player = getPlayer(humanoid)

	-- Touching only happens client-side
	if player == nil then return end

	

	local stats = player:findFirstChild(&quot;leaderstats&quot;)
	if stats == nil then return end

	local gifts_tag = stats:findFirstChild(&quot;Gifts&quot;)
	local points_tag = stats:findFirstChild(&quot;Points&quot;)

	if gifts_tag ~= nil then gifts_tag.Value = gifts_tag.Value + 1 end

	if points_tag ~= nil then points_tag.Value = points_tag.Value + 1 end


end


function onTouched(part)
	local parent = part.Parent
	if parent~=nil then
		local humanoid = parent:findFirstChild(&quot;Humanoid&quot;, false)
		if humanoid ~= nil then
			local p = getPlayer(humanoid)
			if p ~= nil and getRole(p) == &quot;Elf&quot; then
				addGift(humanoid)
				script.Parent.Parent.Parent = nil
			end
		end
	end
end



script.Parent.Touched:connect(onTouched)
</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX24">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">ChristmasInsurrection</string>
				<string name="Source">print(&quot;Christmas Insurrection v. 1.00&quot;)


-- If you need lua help, check out http://lua-users.org/wiki/
-- and also see the Roblox Wiki &quot;Scripting&quot; entry


-- You can tweak the things below to change how the game plays

--------------------- GAME VARIABLES ------------------------
local game_length = 60 * 8 -- this is total game time in seconds.
--------------------------------------------------------------------

local STARTING = 0
local GOING = 1
local ENDED = 2
local state = STARTING

local WaitingPosition = Vector3.new(235, 10.2, 235) -- position players spawn at before the game starts
local SantaSpawn = Vector3.new(-171, 227, -189) -- position that santa spawns at
local ElfSpawn = Vector3.new(-188, 103, 198) -- position that elves spawn

-- Setup some things here
local seed = tick()
math.randomseed(seed) --- init random number generator
print(&quot;Seed &quot;, seed)

local connection = nil
local num_gifts = 0
local regen = game.Workspace.RegenGroup:clone()

message = nil
function showMessage(text)
	-- This function flashes a message to all players
	-- Clear the message with hideMessage()

	hideMessage() -- Never show more than one message at a time
	if message == nil then message = Instance.new(&quot;Message&quot;) end -- only make a message if we don&apos;t have a message object lying around
	message.Text = text
	message.Parent = game.Workspace
end

function hideMessage()
	if message == nil then return end
	message.Parent = nil
end

function ShowMessageToPlayer(player, text)
	RemovePlayerMessages(player)
	local msg = Instance.new(&quot;Message&quot;)
	msg.Text = text
	msg.Parent = player
end

function RemovePlayerMessages(player)
	local c = player:children()
	for i = 1, #c do
		if c[i].className == &quot;Message&quot; then c[i].Parent = nil end
	end
end


-- go through the level and do a recursive search for models named &quot;Present&quot;.
-- for each of those, make the box a random color and attach the GiftScript
function findPresents(instance)
	local kids = instance:children()
	for i = 1, #kids do
		if kids[i].className == &quot;Model&quot; and kids[i].Name == &quot;Present&quot; then
			kids[i].Box.BrickColor = BrickColor.random()
			local s = game.Workspace.GiftScript:clone()
			s.Disabled = false
			s.Parent = kids[i].Box	
			num_gifts = num_gifts + 1
		end
		-- depth-first search
		findPresents(kids[i])
	end
end



function clearPlayerInfo()
	-- resets gift and points
	-- the Whaleboard adds these tags, we just look for them here and reset them
	local players = game.Players:children()
	for i = 1, #players do
		if (players[i]:findFirstChild(&quot;leaderstats&quot;) ~= nil) and (players[i].leaderstats.Gifts ~= nil) then players[i].leaderstats.Gifts.Value = 0 end
		if (players[i]:findFirstChild(&quot;leaderstats&quot;) ~= nil) and (players[i].leaderstats.Points ~= nil) then players[i].leaderstats.Points.Value = 0 end
	end	
end

function getWinnerInfo()
	-- returns a string that we display to everyone about who the winner is

	-- in case of tie, no one wins. if someone wants to code something better, be my guest.
	local highscore = 0
	local winner = &quot;No one&quot;
	local tie = false

	local players = game.Players:children()
	for i = 1, #players do
		local pscore = -1
		if players[i]:findFirstChild(&quot;leaderstats&quot;) ~= nil then 
			if players[i].leaderstats.Points ~= nil then 
				pscore = players[i].leaderstats.Points.Value 
			end
		end

		if pscore == highscore then
			tie = true
		end

		if pscore &gt; highscore then 
			-- new highscore
			highscore = pscore
			winner = players[i].Name
			tie = false
		end
	end
	
	if tie == true then return &quot;There was a tie. How boring.&quot; end
	
	local text = string.format(&quot;%s %s %d %s&quot;, winner, &quot;wins with&quot;, highscore, &quot;points!&quot;)
	return text
end

function RemoveAllWeapons(player)
		-- wipe all weapons
	if player:findFirstChild(&quot;PlayerHopper&quot;) == nil then return end

	local weapons = player.PlayerHopper:children()
	for i = 1, #weapons do
		weapons[i].Parent = nil
	end
end

function GiveWeapons(player)
	local role = getRole(player)
	-- give common weapons
	game.Hopper.Wall:clone().Parent = player.PlayerHopper
	game.Hopper.Snowball:clone().Parent = player.PlayerHopper
	game.Hopper.TimeBomb:clone().Parent = player.PlayerHopper
	game.Hopper.Slingshot:clone().Parent = player.PlayerHopper

	if role == &quot;Elf&quot; then
		-- give Elf weapons
		game.Hopper.Rocket:clone().Parent = player.PlayerHopper
	else
		-- give Santa weapons
		game.Hopper.Multirocket:clone().Parent = player.PlayerHopper
		game.Hopper.JetBoots:clone().Parent = player.PlayerHopper
	end
end


function AssignRole(player, role)
	-- role is a string: either &quot;Elf&quot; or &quot;Santa&quot;
	if player == nil then return end

	-- delete role tag if we see one
	local role_tag = player:findFirstChild(&quot;Role&quot;)
	if role_tag ~= nil then role_tag.Parent = nil end

	role_tag = Instance.new(&quot;StringValue&quot;)
	role_tag.Name = &quot;Role&quot;
	role_tag.Value = role
	role_tag.Parent = player

	RemoveAllWeapons(player)


	print(&quot;Assigned role: &quot;, role)
end

function getRole(player)
	if player:findFirstChild(&quot;Role&quot;) ~= nil then
		return player.Role.Value
	end
	return nil
end

function getSantaPlayer()
	-- returns the player that is santa or nil if there is no santa
	local players = game.Players:children()
	for i = 1, #players do
		if getRole(players[i]) == &quot;Santa&quot; then return players[i] end
	end
	return nil
end


function PickPlayerToBeSanta()
	if game.Players.numPlayers == 0 then return nil end

	local players = game.Players:children()
	return players[math.random(1, #players)]
end

function KillPlayer(player)
	-- safe way to kill a player
	local done = false
	while done == false do
		local char = player.Character
		if char ~= nil then 
			local humanoid = char:findFirstChild(&quot;Humanoid&quot;)
			if humanoid ~= nil then 
				humanoid.Health = 0
				done = true
				print(&quot;found humanoid&quot;)
			end
		end
		wait(2) -- do not hog cpu
	end
	
end


function PlayGame()
	-- this game plays on a loop until the level is killed

	local time_left = 0
	local start_time = 0
	local next_warning_time = 0

	while true do
		-- this game can be in one of 3 states
		if state == STARTING then
			-- When the game is starting, we want to spawn a couple of whales, so things
			-- are going to be laggy. To hide this setup lag, I show some start up info
			showMessage(&quot;Welcome to Christmas Insurrection version 1.00&quot;)			
			wait(5)
			hideMessage()


			-- Reset all game stuff
			findPresents(game.Workspace) -- setup present scripts
			time_left = game_length
			clearPlayerInfo()

			local players = game.Players:children()

			-- set all players to elves
			for i = 1, #players do
				AssignRole(players[i], &quot;Elf&quot;)
			end

			-- pick a santa
			local p = PickPlayerToBeSanta()
			AssignRole(p, &quot;Santa&quot;)

			-- show role instructions
			
			
			local santa_msgs = {&quot;You are SANTA CLAUSE&quot;, &quot;Your treacherous elves are revolting!&quot;, &quot;They are trying to steal your presents!&quot;, &quot;It&apos;s time to teach them a lesson!&quot;}
			local elf_msgs = { &quot;You are an ELF in Santa&apos;s Workshop&quot;,&quot;You slave away making toys 364 days a year&quot;,&quot;You&apos;ve had ENOUGH!&quot;,&quot;Collect as many presents as you can, but avoid Santa!&quot;}

			for n = 1,4 do
				for i = 1, #players do
					if getRole(players[i]) == &quot;Santa&quot; then
						ShowMessageToPlayer(players[i],santa_msgs[n])
					else
						ShowMessageToPlayer(players[i],santa_msgs[n])
					end
				end
				wait(5)
			end
	
			for i = 1, #players do
				RemovePlayerMessages(players[i])
			end

			local text = string.format(&quot;%s %d %s&quot;, &quot;This game will last&quot;, game_length / 60, &quot;minutes&quot;)
			showMessage(text)
			wait(3)
			showMessage(&quot;3&quot;)
			wait(1)
			showMessage(&quot;2&quot;)
			wait(1)
			showMessage(&quot;1&quot;)
			wait(1)
			showMessage(&quot;GO&quot;)
			wait(1)
			hideMessage()

			start_time = tick() -- record system clock at start time
			next_warning_time = start_time + 60

			state = GOING

			-- kill all players to make them respawn; give them weapons
			local players = game.Players:children()
			for i = 1, #players do
				if getRole(players[i]) ~= &quot;Santa&quot; and getRole(players[i]) ~= &quot;Elf&quot; then AssignRole(players[i], &quot;Elf&quot;) end -- this catches the case where someone joined in the last 20 seconds ;-)
				KillPlayer(players[i])
				GiveWeapons(players[i])
			end
		end

		if state == GOING then
			-- when the game is going, we look for several things

			-- 2. we check to see if it is time to flash a countdown message
			-- 3. we check to see if the game should be over

			-- every minute show time left
			if tick() &gt; next_warning_time then
				local text = string.format(&quot;%d %s&quot;, time_left, &quot;seconds left!&quot;)
				showMessage(text)
				wait(4)
				hideMessage()
				next_warning_time = tick() + 60
			end
			
			if time_left &lt; 0 then
				state = ENDED
			end

			time_left = (start_time + game_length) - tick()

		end

		if state == ENDED then
			-- kill all players to make them respawn; take their weapons
			local players = game.Players:children()
			for i = 1, #players do
				KillPlayer(players[i])
				RemoveAllWeapons(players[i])
			end
			showMessage(&quot;GAME OVER!!!&quot;)
			wait(5)
			showMessage(getWinnerInfo())
			wait(8)
			showMessage(&quot;A new game will begin soon... Regenerating.&quot;)
			
			-- regen
			local level = game.Workspace.RegenGroup
			level:remove()

			wait(2)

			level = regen:clone()
			level.Parent = game.Workspace
			level:makeJoints()

			hideMessage()

			wait(2)

			state = STARTING
		end

		wait(2) -- don&apos;t hog the CPU

	end
end
-----------------------------------------------------------------------


function onPlayerEntered(newPlayer)

	AssignRole(newPlayer, &quot;Elf&quot;)
	if state ~= GOING then
		RemoveAllWeapons(newPlayer)
		--KillPlayer(newPlayer)
	else
		GiveWeapons(newPlayer)
	end
	-- start to listen for new humanoid
	connection = newPlayer.Changed:connect(function(property) onPlayerPropChanged(property, newPlayer) end )
	onPlayerRespawn(newPlayer)
end



function elfMorph(player)

	print(&quot;MORPH&quot;)

	-- disconnect to avoid infinite loop
	--if connection ~= nil then connection:disconnect() end

	local char = player.Character

	-- recolor body
	local head = char:findFirstChild(&quot;Head&quot;)
	local torso = char:findFirstChild(&quot;Torso&quot;) 
	local left_arm = char:findFirstChild(&quot;Left Arm&quot;) 
	local right_arm = char:findFirstChild(&quot;Right Arm&quot;) 
	local left_leg = char:findFirstChild(&quot;Left Leg&quot;) 
	local right_leg = char:findFirstChild(&quot;Right Leg&quot;) 

	if head ~= nil then head.BrickColor = BrickColor.new(24) end
	if torso ~= nil then torso.BrickColor = BrickColor.new(37) end
	if left_arm ~= nil then left_arm.BrickColor = BrickColor.new(24) end
	if right_arm ~= nil then right_arm.BrickColor = BrickColor.new(24) end
	if left_leg ~= nil then left_leg.BrickColor = BrickColor.new(119) end
	if right_leg ~= nil then right_leg.BrickColor = BrickColor.new(119) end


	-- reconnect
	-- start to listen for new humanoid
	--connection = player.Changed:connect(function(property) onPlayerPropChanged(property, player) end )
end

function santaMorph(player)

	print(&quot;MORPH SANTA&quot;)

	-- disconnect to avoid infinite loop
	--if connection ~= nil then connection:disconnect() end

	local char = player.Character


	local head = char:findFirstChild(&quot;Head&quot;)
	local torso = char:findFirstChild(&quot;Torso&quot;) 
	local left_arm = char:findFirstChild(&quot;Left Arm&quot;) 
	local right_arm = char:findFirstChild(&quot;Right Arm&quot;) 
	local left_leg = char:findFirstChild(&quot;Left Leg&quot;) 
	local right_leg = char:findFirstChild(&quot;Right Leg&quot;) 

	if head ~= nil then head.BrickColor = BrickColor.new(24) end
	if torso ~= nil then torso.BrickColor = BrickColor.new(26) end
	if left_arm ~= nil then left_arm.BrickColor = BrickColor.new(21) end
	if right_arm ~= nil then right_arm.BrickColor = BrickColor.new(21) end
	if left_leg ~= nil then left_leg.BrickColor = BrickColor.new(21) end
	if right_leg ~= nil then right_leg.BrickColor = BrickColor.new(21) end


	-- reconnect
	-- start to listen for new humanoid
	--connection = player.Changed:connect(function(property) onPlayerPropChanged(property, player) end )
end

function onPlayerPropChanged(property, player)
	if property == &quot;Character&quot; and player.Character ~= nil then
		onPlayerRespawn(player)
	end
end


function onPlayerRespawn(player)
	
print(&quot;on RESPAWN&quot;)
	-- only interested in events where the player gets a new character
       if player.Character == nil then return end

	if getRole(player) == &quot;Elf&quot; then elfMorph(player) end
	if getRole(player) == &quot;Santa&quot; then santaMorph(player) end

	local x = 0
	local y = 0
	local z = 0

	x = WaitingPosition.x + math.random(-5, 5)
	y = WaitingPosition.y + math.random(5,8)
	z = WaitingPosition.z + math.random(-5,5)
	if getRole(player) == &quot;Santa&quot; and state == GOING then
			x = SantaSpawn.x + math.random(-5, 5)
			y = SantaSpawn.y + math.random(5,8)
			z = SantaSpawn.z + math.random(-5,5)
	end
	if getRole(player) == &quot;Elf&quot; and state == GOING then
			x = ElfSpawn.x + math.random(-15, 15)
			y = ElfSpawn.y + math.random(5,20)
			z = ElfSpawn.z + math.random(-15,15)
	end

	--local char = nil
	--while true do
		local char = player.Character.Torso
	--	if char ~= nil then break end
	--	wait(2)
	--	print(&quot;LLL&quot;)
	--end
	local cf = char.CFrame

	local lx = 0
	local ly = y
	local lz = 0

	char.CFrame = CFrame.new(Vector3.new(x,y,z), Vector3.new(lx,ly,lz))
	print(&quot;Moved player&quot;)

	--player.Character:move(Vector3.new(x,y,z))

end
----------------------------------------------------------------------------------------
game.Players.ChildAdded:connect(onPlayerEntered)

PlayGame()


