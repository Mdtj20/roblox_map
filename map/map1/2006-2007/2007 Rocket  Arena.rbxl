					<ProtectedString name="Source">model = game.Workspace.Regen
messageText = &quot;Regenerating Bridges...&quot;

message = Instance.new(&quot;Message&quot;)
message.Text = messageText
backup = model:clone()

while true do
	wait(300)

	message.Parent = game.Workspace
	model:remove()

	wait(4)

	model = backup:clone()
	model.Parent = game.Workspace
	model:makeJoints()
	message.Parent = nil
end
