local debounce = false


function onHit(hit)
	local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (human ~= nil) and debounce == false then

                debounce = true

local message = Instance.new(&quot;Message&quot;)
message.Parent = game.Players:playerFromCharacter(hit.Parent)
message.Text = &quot;You&apos;ve found your way here,&quot;
wait(5)
message.Text = &quot;But can you continue?&quot;
wait(5)
message.Text = &quot;Will you find my precious?&quot;
wait(5)
message.Text = &quot;Only time will tell...&quot;
wait(5)

message:Remove ()

                debounce = false
	end
end

