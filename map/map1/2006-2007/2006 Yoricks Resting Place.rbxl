				<Item class="Script" referent="RBX10">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">MessageBox</string>
						<string name="Source">print(&quot;Mattcena&apos;s message box&quot;)

local debounce = false


function onHit(hit)
	local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (human ~= nil) and debounce == false then

                debounce = true

local message = Instance.new(&quot;Message&quot;)
message.Parent = game.Players:playerFromCharacter(hit.Parent)
message.Text = &quot;Alive without breath, As cold as death;&quot;
wait(5)
message.Text = &quot;Never thirsty, ever drinking,&quot;
wait(5)
message.Text = &quot;All in mail never clinking.&quot;
wait(5)
message.Text = &quot;Speak your answer aloud to continue...&quot;
wait(5)

message:Remove ()

                debounce = false
	end
end

script.Parent.Touched:connect(onHit)</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
