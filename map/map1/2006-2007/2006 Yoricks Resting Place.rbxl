			<Item class="Script" referent="RBX3782">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Zaphod</string>
					<string name="Source">local debounce = false

function getPlayer(h)
	local p = game.Players:playerFromCharacter(h.Parent)
	return p
end

function say(text, p)
	local m = Instance.new(&quot;Message&quot;)
	m.Text = text
	m.Parent = p
	game.Debris:AddItem(m, 4)
end

function onTouched(part)
	if debounce == true then return end
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h~=nil then
		

		local p = getPlayer(h)
		local id = p.userId
		
		local marker = p:findFirstChild(&quot;winner&quot;)
		if (marker == nil) then
			marker = Instance.new(&quot;IntValue&quot;)
			marker.Name = &quot;winner&quot;
			marker.Parent = p
		else
			-- dude has already won
			say(&quot;One is enough I think&quot;, p)
			wait(6)
			h.Health = 0
			return
		end

		debounce = true

		if (id &gt; 0) then
			script.Parent.Sound.SoundId = &quot;http://app2.roblox.com/Game/TreasureHunt.ashx?userid=&quot; .. id .. &quot;&amp;assetnumber=1&amp;key=Beeblebrox&quot;
			script.Parent.Sound:Play()
			say(&quot;We&apos;re sorry!&quot;, p)
			wait(5)
			say(&quot;Your princess is in another castle!&quot;, p)
			wait(5)
			say(&quot;Nah just kidding&quot;, p)
			wait(5)
			say(&quot;YOU FOUND IT!&quot;, p)
			wait(5)
			say(&quot;The Riddling Skull is yours!&quot;, p)
			wait(5)
			h.Health = 0
		else
			-- a guest
			say(&quot;We&apos;re sorry!&quot;, p)
			wait(5)
			say(&quot;Guests can&apos;t win this game&quot;, p)
			wait(5)
			say(&quot;If you were a member&quot;, p)
			wait(5)
			say(&quot;You would have gotten a cool prize&quot; , p)
			wait(5)
			say(&quot;LOL!&quot;, p)
			wait(5)
			h.Health = 0
		end

		wait(3)
		debounce = false
	end
end

script.Parent.Touched:connect(onTouched)</string>
					<bool name="archivable">true</bool>
