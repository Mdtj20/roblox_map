							<Item class="Script" referent="RBX2699">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">SummonKillbot</string>
									<ProtectedString name="Source">-- Touching this Battle Armor doubles you MaxHealth and heals you to full power

local debounce = false
local killbot = game.Workspace.Killbot:clone()


function getPlayer(humanoid)
	-- find the owning player of a humanoid.
	local players = game.Players:children()
	for i = 1, #players do
		if players[i].Character ~= nil then
			if players[i].Character.Humanoid == humanoid then return players[i] end
		end
	end
	return nil
end


function summonKillbot(humanoid)
	local player = getPlayer(humanoid)

	local x = math.random(-60,60)
	local y = math.random(40,60)
	local z = math.random(-60,60)

	local newbot = killbot:clone()

	newbot.OwningTeam.Value = &quot;Blue Falcons&quot;
	newbot.Parent = game.Workspace
	newbot.Sphere.BodyPosition.position = Vector3.new(x,y,z) -- little hack a little necessary
	newbot:move(Vector3.new(x,y,z))
	
	
	if player ~= nil then
		local message = Instance.new(&quot;Message&quot;)
		message.Text = &quot;The sphere hums...&quot;
		message.Parent = player
		wait(5)
		message.Text = &quot;You have summoned a Blue killbot!&quot;
		wait(5)
		message.Parent = nil
	end


end


function onTouched(hit)
	local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if humanoid~=nil and debounce == false then
		debounce = true
		script.Parent.BrickColor = BrickColor.new(26)
		summonKillbot(humanoid)
		wait(3)
		script.Parent.BrickColor = BrickColor.new(23)
		debounce = false
	end
end


script.Parent.Touched:connect(onTouched)</ProtectedString>
									<bool name="archivable">true</bool>
